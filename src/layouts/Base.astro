---
import { Font } from 'astro:assets';
import CommandPalette from '../components/CommandPalette.astro';
import Intro from '../components/Intro.astro';
import Nav from '../components/Nav.astro';
import Contact from '../components/sections/Contact.astro';
import { getSite } from '../lib/content';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Keeps the page out of search results, for pages reachable only by their URL (like /resume). */
  noindex?: boolean;
}

const site = await getSite();
const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} / ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {/* public/og.jpg is made by `npm run share-image`. */}
    <meta property="og:image" content={new URL('/og.jpg', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Portrait of ${site.name} beside the name, the line “${site.pitch[0]}”, jasonpereira.live and “${site.availability}”`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ECE7DC" />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-dm-sans" preload />
    <Font cssVariable="--font-instrument" />
    <script is:inline>
      /* Mark the page as scripted before first paint, so nothing the page script will hide is laid out or downloaded first. */
      document.documentElement.classList.add('js');
      /* The site opens with the intro (src/scripts/intro.ts) on the first page of a visit and on every reload, but not
         when moving between its pages, when motion is reduced, or when the page loads out of sight (a hidden page
         gets no animation frames, so the intro would stall). */
      (function () {
        try {
          var entry = performance.getEntriesByType('navigation')[0];
          var reloaded = entry !== undefined && entry.type === 'reload';
          var seen = sessionStorage.getItem('jp-intro-seen');
          /* Recorded before it plays, and even when it is skipped for a hidden page, so it never replays when
             moving between pages, even if the page script fails. */
          sessionStorage.setItem('jp-intro-seen', '1');
          if ((reloaded || !seen) && !document.hidden && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('has-intro');
          }
        } catch (error) {
          /* Storage is blocked (reading or writing): skip the intro rather than replay it on every page. */
        }
      })();
      /* If the page script never ran (blocked, or it failed to load), go back to the no-script layout. */
      addEventListener('load', function () {
        if (!document.documentElement.dataset.scripted) document.documentElement.classList.remove('js');
      });
    </script>
  </head>
  <body>
    <Intro />
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Contact />
    <CommandPalette />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
