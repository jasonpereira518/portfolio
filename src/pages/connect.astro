---
import Base from '../layouts/Base.astro';
import ConnectCard from '../components/ConnectCard.astro';
import Home from '../components/Home.astro';
import { getSite } from '../lib/content';

const site = await getSite();
---
{/* Unlisted, like /resume: the link sent to recruiters. The homepage under a card of every way to reach Jason. */}
<Base
  title="Connect"
  description={`Email, LinkedIn, GitHub, Google Scholar and resume for ${site.name}. ${site.availability}.`}
  noindex
  noIntro
>
  <Home />
  <ConnectCard />
</Base>
