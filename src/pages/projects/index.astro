---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Medal from '../../components/Medal.astro';
import { asset } from '../../lib/assets';
import { getCardsByGroup, getFlagship } from '../../lib/content';

const [flagship, groups] = await Promise.all([getFlagship(), getCardsByGroup()]);
---
<Base
  title="Projects"
  description="Everything Jason Pereira has built: AI products, full-stack apps, quant projects, hackathon wins and a rocket motor."
>
  <section class="index section theme-paper" data-island="projects-media">
    <p class="index__lede">AI products, full-stack apps, quant systems, hackathon wins and one rocket motor.</p>
    <h1 class="index__title display">Everything I've built.</h1>

    <ul class="index__flagship">
      {flagship.map((project, index) => (
        <li>
          <a class="feature" href={`/projects/${project.id}`}>
            <div class="feature__frame">
              <div class:list={['feature__media', { 'feature__media--whole': project.data.coverFit === 'contain' }]}>
                <Image
                  src={asset(`projects/${project.data.cover}`)}
                  alt=""
                  widths={[480, 720, 960, 1280, 1600]}
                  quality={90}
                  sizes="(max-width: 800px) 92vw, 48vw"
                  loading={index < 2 ? 'eager' : 'lazy'}
                />
                {project.data.hoverImage && (
                  <Image
                    class="feature__alt"
                    src={asset(`projects/${project.data.hoverImage}`)}
                    alt=""
                    widths={[480, 720, 960, 1280, 1600]}
                    quality={90}
                    sizes="(max-width: 800px) 92vw, 48vw"
                    loading="lazy"
                  />
                )}
                {project.data.video && (
                  <video class="feature__video" muted loop playsinline preload="none" disablepictureinpicture aria-hidden="true" tabindex="-1">
                    <source src={`/projects/${project.data.video}`} type="video/mp4" />
                  </video>
                )}
              </div>
              {project.data.badge && <Medal text={project.data.badge} detail={project.data.badgeDetail} />}
            </div>
            <h2 class="feature__title display" data-title-lines="2" style={project.data.color ? `--project:${project.data.color}` : undefined}>{project.data.title}</h2>
            <p class="feature__tagline">{project.data.blurb ?? project.data.tagline}</p>
            <p class="feature__meta label">{project.data.dates}</p>
          </a>
        </li>
      ))}
    </ul>

    {groups.map((group) => (
      <section class="index__group" aria-labelledby={`group-${group.group}`}>
        <h2 class="index__group-title label" id={`group-${group.group}`}>{group.label}</h2>
        <div class="index__cards">
          {group.projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    ))}
  </section>
</Base>

<style>
  .index {
    padding-top: calc(var(--nav-height) + clamp(2.5rem, 6vw, 6rem));
  }

  .index__lede {
    margin-bottom: 1rem;
    color: var(--muted);
    font-family: Calibri, Carlito, 'Segoe UI', sans-serif;
    font-size: clamp(1.125rem, 0.95rem + 0.9vw, 1.75rem);
    line-height: 1.3;
  }

  .index__title {
    margin-bottom: clamp(2rem, 4.5vw, 4rem);
    font-size: clamp(1.6rem, 0.4rem + 5vw, 5.5rem);
    overflow-wrap: anywhere;
  }

  .index__flagship {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .feature {
    display: grid;
    gap: 0.5rem;
    text-decoration: none;
  }

  /* The frame does not clip, so the medal's hover card can hang over the image's edge. */
  .feature__frame {
    position: relative;
    margin-bottom: 0.5rem;
  }

  .feature__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: var(--media-radius);
    background: var(--line);
  }

  .feature__media :global(img),
  .feature__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The hover clip sits over the still and fades in once its first frame is up (src/scripts/projects-media.ts). */
  .feature__video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }

  .feature__video:global(.is-playing) {
    opacity: 1;
  }

  /* An alternate image fades in over the cover while the row is hovered (CSS only, no script). */
  .feature__media :global(.feature__alt) {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: #fff;
    transition: opacity 0.4s var(--ease);
  }

  .feature:hover .feature__media :global(.feature__alt),
  .feature:focus-visible .feature__media :global(.feature__alt) {
    opacity: 1;
  }

  /* A chart is shown whole on its own white ground; a screenshot is cropped to fill the frame. */
  .feature__media--whole {
    background: #fff;
  }

  .feature__media--whole :global(img),
  .feature__media--whole .feature__video {
    object-fit: contain;
  }

  @media (prefers-reduced-motion: no-preference) {
    .feature__media :global(img) {
      transition: transform 0.6s var(--ease);
    }

    .feature:hover .feature__media :global(img) {
      transform: scale(1.03);
    }
  }

  .feature__title {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3.5rem);
    overflow-wrap: anywhere;
    color: var(--project, inherit); /* the project's own colour, from its frontmatter */
  }

  .feature__tagline {
    font-family: Calibri, Carlito, 'Segoe UI', sans-serif;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.4rem);
    max-width: 40ch;
  }

  .feature__tagline,
  .feature__meta {
    color: var(--muted);
  }

  .index__group {
    margin-top: var(--section-gap);
  }

  .index__group-title {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  @media (min-width: 800px) {
    .index__flagship,
    .index__cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.25rem, 2.4vw, 2rem);
    }
  }

  /* The hover preview is created by src/scripts/projects-media.ts, so the page's scoped styles do not reach it. It is
     the same preview as on jasonpereira.live. */
  :global(#project-hover-preview) {
    --preview-tilt: 0deg;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1400;
    width: 280px;
    height: 210px;
    max-width: min(360px, 30vw);
    max-height: min(300px, 38vh);
    overflow: hidden;
    border: 1px solid rgb(145 145 155 / 0.22);
    border-radius: 1.2rem;
    background: #060607;
    box-shadow: 0 22px 50px rgb(0 0 0 / 0.28);
    opacity: 0;
    visibility: hidden;
    transform: perspective(1400px) rotateY(var(--preview-tilt)) scale(0.96);
    transform-origin: center;
    transition: opacity 0.22s, transform 0.22s, visibility 0.22s;
    pointer-events: none;
  }

  :global(#project-hover-preview::before) {
    content: '';
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: -16px;
    z-index: -1;
    height: 24px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.28);
    filter: blur(14px);
    pointer-events: none;
  }

  /* A fade to dark under the title. */
  :global(#project-hover-preview::after) {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    background: linear-gradient(to top, rgb(0 0 0 / 0.58), rgb(0 0 0 / 0));
    pointer-events: none;
  }

  :global(#project-hover-preview.is-visible) {
    opacity: 1;
    visibility: visible;
    transform: perspective(1400px) rotateY(var(--preview-tilt)) scale(1);
  }

  :global(#project-hover-preview.is-right-side) {
    --preview-tilt: -14deg;
  }

  :global(#project-hover-preview.is-left-side) {
    --preview-tilt: 14deg;
  }

  :global(.project-hover-preview__media) {
    width: 100%;
    height: 100%;
  }

  :global(.project-hover-preview__image),
  :global(.project-hover-preview__video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.project-hover-preview__image[hidden]),
  :global(.project-hover-preview__video[hidden]) {
    display: none;
  }

  :global(.project-hover-preview__title) {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.85rem;
    z-index: 1;
    margin: 0;
    color: #f1f1f3;
    font-size: 0.95rem;
    font-weight: 600;
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.6);
  }

  /* Small screens and touch have no hover. */
  @media (max-width: 1000px), (hover: none), (pointer: coarse) {
    :global(#project-hover-preview) {
      display: none;
    }
  }
</style>
