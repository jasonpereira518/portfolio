---
import { Image } from 'astro:assets';
import { asset } from '../../lib/assets';
import { getEducation, getExperience } from '../../lib/content';

const [roles, schools] = await Promise.all([getExperience(), getEducation()]);
---
<section class="xp section theme-paper" id="experience">
  <header class="section__head">
    <h2 class="label">Experience</h2>
  </header>
  <ol class="xp__list xp__list--roles">
    {roles.map((item, index) => (
      <li class="xp__row" data-reveal style={`--i:${index % 3}${item.data.color ? `;--org:${item.data.color}` : ''}`}>
        <div class="xp__who">
          <h3 class="xp__org display" data-title-lines="6">{item.data.org}</h3>
        </div>
        <p class="xp__role">{item.data.role}</p>
        <p class="xp__meta label">{[item.data.place, item.data.dates].filter(Boolean).join(' · ')}</p>
        <p class="xp__summary">{item.data.summary}</p>
        {item.data.logo && <Image class="xp__logo" src={asset(item.data.logo)} alt="" width={160} loading="lazy" />}
      </li>
    ))}
  </ol>

  <h2 class="xp__sub label">Education</h2>
  <ul class="xp__list xp__list--schools">
    {schools.map((item) => (
      <li class="xp__row" data-reveal style={item.data.color ? `--org:${item.data.color}` : undefined}>
        {item.data.logo && <Image class="xp__logo" src={asset(item.data.logo)} alt="" width={160} loading="lazy" />}
        <h3 class="xp__org display">{item.data.school}</h3>
        <p class="xp__role">{item.data.detail}</p>
        <p class="xp__meta label">{item.data.dates}</p>
        {item.data.awards.length > 0 && (
          <p class="xp__awards">
            {item.data.awards.map((award, index) => (
              <>
                {index > 0 && ' · '}
                {award.prefix}
                {award.href ? (
                  <a href={award.href} target="_blank" rel="noopener" style={award.color ? `color:${award.color}` : undefined}>{award.label}</a>
                ) : (
                  <span style={award.color ? `color:${award.color}` : undefined}>{award.label}</span>
                )}
              </>
            ))}
          </p>
        )}
        {item.data.courses.length > 0 && (
          <details class="xp__courses">
            <summary><span>Coursework</span></summary>
            <p>{item.data.courses.join(' · ')}</p>
          </details>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  /* Every logo gets the same square box, so the names and details line up whether or not a row has a logo. */
  .xp__list {
    --logo: clamp(2.5rem, 2rem + 1.6vw, 3.5rem);

    border-bottom: 1px solid var(--line);
  }

  .xp__row {
    display: grid;
    gap: 0.35rem 2rem;
    padding-block: clamp(1.1rem, 2.2vw, 1.9rem);
    border-top: 1px solid var(--line);
  }

  /* The section head already draws a rule above the first role. */
  .xp__list--roles .xp__row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  /* The logo is a transparent image, decorative (the name says who it is), so it has no alt text. A company's sits
     at the far right of its row, a school's at the far left. */
  .xp__row :global(.xp__logo) {
    align-self: center;
    width: var(--logo);
    height: var(--logo);
    object-fit: contain;
  }

  /* A word in a name is never broken to fit: src/scripts/fit-titles.ts makes the name smaller instead. */
  .xp__who {
    min-width: 0;
  }

  .xp__who .xp__org {
    min-width: 0;
    overflow-wrap: normal;
  }

  .xp__org {
    font-size: clamp(1.25rem, 1rem + 1.4vw, 2.25rem);
    overflow-wrap: anywhere;
  }

  /* The role is set in the organisation's own colour (--org, set on the row from its frontmatter). */
  .xp__role {
    color: var(--org, inherit);
    font-weight: 700;
  }

  /* Company and school names are in ordinary capitals rather than the display style's all caps, and at the font's
     normal width rather than its widest. A school's name is in the school's colour. */
  .xp__org {
    font-stretch: 100%;
    line-height: 1.1;
    text-transform: none;
  }

  .xp__list--schools .xp__org {
    color: var(--org, inherit);
  }

  /* Every school's detail line is in ink, not the school colour, so only the name carries it. */
  .xp__list--schools .xp__role {
    color: inherit;
  }

  /* Under a school's details: its honours in ink, then the coursework, quieter. */
  .xp__awards {
    font-weight: 500;
  }

  .xp__awards a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .xp__courses {
    color: var(--muted);
    font-family: Calibri, Carlito, 'Segoe UI', sans-serif;
  }

  /* "Coursework" is a native disclosure: the list opens under it, and the button text flips with its state. */
  .xp__courses summary {
    display: inline-flex;
    gap: 0.6rem;
    cursor: pointer;
    list-style: none;
  }

  .xp__courses summary::-webkit-details-marker {
    display: none;
  }

  .xp__courses summary::after {
    content: 'See more';
    color: var(--fg);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .xp__courses[open] summary::after {
    content: 'See less';
  }

  .xp__courses p {
    margin-top: 0.25rem;
  }

  .xp__meta,
  .xp__summary {
    color: var(--muted);
  }

  .xp__summary {
    font-family: Calibri, Carlito, 'Segoe UI', sans-serif;
    max-width: 62ch;
  }

  .xp__sub {
    margin: clamp(2.5rem, 5vw, 4.5rem) 0 1rem;
    color: var(--muted);
  }

  /* Narrow screens: the lines stack in one column, the logo beside them (wide screens place everything by area). */
  @media (max-width: 899px) {
    .xp__list--roles .xp__row {
      grid-template-columns: minmax(0, 1fr) var(--logo);
    }

    .xp__list--roles .xp__row > :not(:global(.xp__logo)) {
      grid-column: 1;
    }

    .xp__list--roles :global(.xp__logo) {
      grid-column: 2;
      grid-row: 1 / span 4;
    }

    .xp__list--schools .xp__row {
      grid-template-columns: var(--logo) minmax(0, 1fr);
    }

    .xp__list--schools .xp__row > :not(:global(.xp__logo)) {
      grid-column: 2;
    }

    .xp__list--schools :global(.xp__logo) {
      grid-column: 1;
      grid-row: 1 / span 5;
    }

  }

  @media (min-width: 900px) {
    .xp__list--roles .xp__row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 3fr) minmax(0, 4fr) var(--logo);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'org role summary logo'
        'org meta summary logo';
    }

    .xp__list--schools .xp__row {
      grid-template-columns: var(--logo) minmax(0, 4fr) minmax(0, 8fr);
      grid-template-rows: auto auto auto 1fr;
      grid-template-areas:
        'logo org role'
        'logo org meta'
        'logo org awards'
        'logo org courses';
    }

    .xp__row :global(.xp__logo) {
      grid-area: logo;
    }

    .xp__org,
    .xp__who {
      grid-area: org;
    }

    .xp__who {
      align-self: start;
    }

    .xp__role {
      grid-area: role;
    }

    .xp__awards {
      grid-area: awards;
    }

    .xp__courses {
      grid-area: courses;
    }

    .xp__meta {
      grid-area: meta;
    }

    .xp__summary {
      grid-area: summary;
    }
  }
</style>
