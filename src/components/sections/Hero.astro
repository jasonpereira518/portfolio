---
import { Picture } from 'astro:assets';
import Button from '../Button.astro';
import ContourBg from '../ContourBg.astro';
import { asset } from '../../lib/assets';
import { getSite } from '../../lib/content';

const site = await getSite();
const portrait = asset('portrait.png');
---
<section class="hero theme-paper" id="top" data-island="hero-wash">
  <ContourBg />
  <div class="hero__foot">
    <div class="hero__tags label">
      <p>{site.availability}</p>
      <p>{site.location}</p>
    </div>
    <h1 class="hero__wordmark display" data-fit><span>{site.name}</span></h1>
  </div>
  <div class="hero__copy">
    <p class="hero__pitch">
      {site.pitch.map((line) => <span>{line}</span>)}
    </p>
    <div class="hero__cta">
      <Button href="#work" variant="solid">See the work</Button>
      <Button href="/resume">Resume</Button>
    </div>
  </div>
  <figure class="hero__figure" data-island="hero-tilt">
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      widths={[360, 540, 720, 800, 960, 1200]}
      sizes="(max-width: 720px) 100vw, min(46vw, 620px)"
      alt={`Portrait of ${site.name}`}
      priority
    />
  </figure>
  <canvas class="hero__wash" aria-hidden="true"></canvas>
</section>

<style>
  /* Layers, back to front: contour lines, portrait (1), tags and wordmark (2), paint (3), copy and buttons (4). */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding: calc(var(--nav-height) + 1rem) var(--gutter) 0;
  }

  .hero__copy {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .hero__pitch {
    display: grid;
    gap: 0.15em;
    max-width: 24ch;
    font-size: clamp(0.95rem, 0.75rem + 0.85vw, 1.4rem);
    font-weight: 800;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .hero__pitch span {
    text-wrap: balance;
  }

  .hero__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }

  .hero__figure {
    position: absolute;
    bottom: 0;
    left: 50%;
    z-index: 1;
    width: min(46vw, 620px);
    translate: -50% 0;
    transform-origin: 50% 100%;
    touch-action: pan-y;
  }

  /* Turned towards the mouse by src/scripts/hero-tilt.ts. The perspective is part of the transform, so its vanishing
     point is the transform origin, the middle of the bottom edge: that edge stays on the floor of the hero while the
     head turns. */
  .hero__figure[data-tilt='ready'] {
    transform: perspective(1000px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
  }

  .hero__figure :global(img) {
    width: 100%;
    height: auto;
    max-height: 82svh;
    object-fit: contain;
    object-position: bottom;
  }

  /* Paper plus ink with difference blending: exact ink over the paper, exact paper over the dark suit. */
  .hero__foot {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(0.5rem, 1.2vw, 1.25rem);
    left: var(--gutter);
    z-index: 2;
    color: var(--blend-ink);
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .hero__tags {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }

  .hero__wordmark {
    --fit-base: 8.4vw;
  }

  .hero__wash {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    opacity: 0.8;
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .hero__copy {
      flex-direction: column;
    }

    .hero__cta {
      flex-direction: row;
      align-items: center;
    }

    .hero__tags {
      flex-direction: column;
      gap: 0.15rem;
    }

    /* Full width, so the portrait's cropped shoulders run off both edges of the screen. */
    .hero__figure {
      width: 100%;
    }

    .hero__figure :global(img) {
      max-height: 58svh;
    }
  }
</style>
