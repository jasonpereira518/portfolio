---
import { Picture } from 'astro:assets';
import Button from '../Button.astro';
import { asset } from '../../lib/assets';
import { getSite } from '../../lib/content';

const site = await getSite();
const poster = asset('hero-stage.jpg');
---
<section class="hero theme-ink" id="top" data-island="hero-ink">
  <div class="hero__backdrop" aria-hidden="true">
    <!-- The still shows until the video is playing, and stays when it cannot play (no script, reduced motion, an
         error). The video is started by scripts/hero-ink.ts, so it is never fetched when it will not be shown. -->
    <Picture
      class="hero__poster"
      src={poster}
      formats={['avif', 'webp']}
      widths={[720, 1080, 1440, 2000]}
      sizes="100vw"
      alt=""
      priority
    />
    <video class="hero__video" muted loop playsinline preload="none" disablepictureinpicture>
      <source src="/hero/stage.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="hero__foot">
    <div class="hero__tags label">
      <p>{site.availability}</p>
      <p>{site.location}</p>
    </div>
    <h1 class="hero__wordmark display" data-fit><span>{site.name}</span></h1>
  </div>
  <div class="hero__copy">
    <p class="hero__pitch">
      {site.pitch.map((line) => <span>{line}</span>)}
    </p>
    <div class="hero__cta">
      <Button href="#work" variant="solid">See the work</Button>
      <Button href="/resume">Resume</Button>
    </div>
  </div>
  <canvas class="hero__ink" aria-hidden="true"></canvas>
</section>

<style>
  /* Layers, back to front: video under its dark scrim (0), paint (1), tags and wordmark (2), copy and buttons (4). */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding: calc(var(--nav-height) + 1rem) var(--gutter) 0;
  }

  .hero__copy {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .hero__pitch {
    display: grid;
    gap: 0.15em;
    max-width: 24ch;
    font-size: clamp(0.95rem, 0.75rem + 0.85vw, 1.4rem);
    font-weight: 800;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .hero__pitch span {
    text-wrap: balance;
  }

  .hero__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--ink);
    pointer-events: none;
  }

  .hero__backdrop :global(img),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hidden until its first frame is up, so it never flashes black over the still. */
  .hero__video {
    opacity: 0;
    transition: opacity 0.8s var(--ease);
  }

  .hero__video.is-playing {
    opacity: 1;
  }

  /* Darkens the footage so the text reads: heaviest at the top (pitch, buttons) and bottom (wordmark). */
  .hero__backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgb(18 18 16 / 0.82) 0%,
        rgb(18 18 16 / 0.5) 34%,
        rgb(18 18 16 / 0.5) 58%,
        rgb(18 18 16 / 0.9) 100%
      ),
      rgb(18 18 16 / 0.2);
  }

  .hero__foot {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(0.5rem, 1.2vw, 1.25rem);
    left: var(--gutter);
    z-index: 2;
    pointer-events: none;
  }

  .hero__tags {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }

  .hero__wordmark {
    --fit-base: 8.4vw;
  }

  .hero__ink {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    opacity: 0.65;
    pointer-events: none;
  }

  @media (max-width: 720px) {
    .hero__copy {
      flex-direction: column;
    }

    .hero__cta {
      flex-direction: row;
      align-items: center;
    }

    .hero__tags {
      flex-direction: column;
      gap: 0.15rem;
    }
  }
</style>
