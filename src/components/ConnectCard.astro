---
// The contact card /connect opens on, over the homepage: the link Jason sends recruiters. Closing it (×, "View
// portfolio", Esc or a click outside) leaves them on the homepage. Without scripts it never opens, and the footer
// still has every link.
import Button from './Button.astro';
import ContourBg from './ContourBg.astro';
import { getSite } from '../lib/content';

const site = await getSite();

// Each link with its logo (24 x 24 box), drawn in `colour` and turning the button's text colour once it fills on
// hover. Brand marks are from Simple Icons (CC0), in the same brand colours the footer buttons fill with.
const links = [
  { label: 'Email', href: `mailto:${site.email}`, colour: 'var(--accent)', stroke: true,
    icon: 'M3 5h18v14H3zM3 6l9 7 9-7' },
  { label: 'LinkedIn', href: site.links.linkedin, external: true, brand: '#0A66C2',
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
  { label: 'GitHub', href: site.links.github, external: true, brand: '#6E5494',
    icon: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12' },
  { label: 'Google Scholar', href: site.links.scholar, external: true, brand: '#4285F4',
    icon: 'M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z' },
  // The PDF in public/, opened in a new tab so the card stays put behind it.
  { label: 'Resume', href: '/Jason_Pereira_Resume.pdf', external: true, colour: 'var(--accent)', stroke: true,
    icon: 'M6 2h9l5 5v15H6zM14 2v6h6M9 13h8M9 17h8' },
  { label: 'Achievements', href: '/achievements', colour: 'var(--accent)',
    icon: 'M12 2l2.9 6.9 7.1.6-5.4 4.7 1.7 7-6.3-3.8-6.3 3.8 1.7-7L2 9.5l7.1-.6z' },
];
---
<dialog id="connect" class="connect theme-ink" aria-labelledby="connect-name" data-lenis-prevent>
  <ContourBg />
  <form method="dialog">
    <button class="connect__close" aria-label="Close">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </button>
  </form>
  <p class="label connect__muted">{site.availability}</p>
  <h2 id="connect-name" class="connect__name display">{site.name}</h2>
  <div class="connect__email">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <button class="connect__pill" type="button" data-copy={site.email}>Copy</button>
  </div>
  <div class="connect__links">
    {links.map(({ label, href, external, brand, colour, stroke, icon }) => (
      <Button href={href} external={external} brand={brand}>
        <svg
          slot="icon"
          class="connect__icon"
          style={`--icon:${brand ?? colour}`}
          viewBox="0 0 24 24"
          width="16"
          height="16"
          aria-hidden="true"
        >
          <path
            d={icon}
            fill={stroke ? 'none' : 'currentColor'}
            stroke={stroke ? 'currentColor' : undefined}
            stroke-width={stroke ? 2 : undefined}
            stroke-linejoin="round"
          ></path>
        </svg>
        {label}
      </Button>
    ))}
  </div>
  <form method="dialog" class="connect__foot">
    <button class="connect__pill connect__pill--solid">View portfolio</button>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#connect')!;
  const copy = dialog.querySelector<HTMLButtonElement>('[data-copy]')!;

  dialog.showModal();

  // A click on the backdrop lands on the dialog itself, outside its box (as in palette.ts).
  dialog.addEventListener('click', (event) => {
    const box = dialog.getBoundingClientRect();
    const outside = event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom;
    if (outside) dialog.close();
  });

  // Once closed, this is just the homepage, so the address says so (and a reload doesn't bring the card back).
  dialog.addEventListener('close', () => history.replaceState(null, '', '/'));

  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.copy!);
      copy.textContent = 'Copied';
    } catch {
      copy.textContent = 'Copy failed';
    }
    setTimeout(() => (copy.textContent = 'Copy'), 2000);
  });
</script>

<style>
  .connect {
    position: fixed;
    isolation: isolate;
    /* Scrolls on short phones, where the stacked buttons can outgrow the screen. */
    overflow: hidden auto;
    box-sizing: border-box;
    width: min(34rem, calc(100vw - 2 * var(--gutter)));
    max-height: calc(100dvh - 2 * var(--gutter));
    margin: auto;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-family: var(--font-body);
  }

  .connect[open] {
    display: grid;
    gap: 1.25rem;
  }

  .connect::backdrop {
    background: rgb(18 18 16 / 0.55);
    backdrop-filter: blur(2px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .connect[open] {
      animation: connect-in 0.25s var(--ease);
    }
  }

  @keyframes connect-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.98);
    }
  }

  .connect__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .connect__close:hover {
    border-color: var(--fg);
  }

  .connect__muted {
    color: var(--muted);
    padding-right: 3rem; /* clear of the close button */
  }

  .connect__name {
    font-size: clamp(2rem, 7vw, 3rem);
  }

  .connect__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: 1.0625rem;
  }

  .connect__email a {
    overflow-wrap: anywhere;
    text-decoration-color: var(--line);
    text-underline-offset: 0.2em;
  }

  .connect__email a:hover {
    color: var(--accent);
  }

  /* An even grid: two equal columns where they fit (one on phones), each button full width with its logo and
     label on the left and the arrow on the right. */
  .connect__links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.6rem;
  }

  .connect__links :global(.button) {
    padding-block: 0.9rem;
  }

  .connect__links :global(.button__arrow) {
    margin-left: auto;
  }

  .connect__icon {
    flex: none;
    color: var(--icon);
    transition: color 0.25s var(--ease);
  }

  /* Once the button fills with the brand colour, the logo takes the text colour so it stays visible. */
  .connect__links :global(.button:hover) .connect__icon {
    color: inherit;
  }

  .connect__foot {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  /* Buttons styled like Button.astro's links (which are <a>s, so can't close the dialog). */
  .connect__pill {
    padding: 0.6rem 0.9rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .connect__pill:hover {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }

  .connect__pill--solid {
    width: 100%;
    padding: 0.9rem 1.15rem;
    border-color: var(--accent);
    background: var(--accent);
    color: var(--ink);
  }
</style>
