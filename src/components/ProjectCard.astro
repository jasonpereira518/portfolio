---
import { getImage, Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { asset } from '../lib/assets';
import Medal from './Medal.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

// The card's id is the project's slug, so other pages can link straight to it (/projects#brain-bubble-pop).
const { id, data } = Astro.props.project;

// A card with a thumbnail shows it to the right of the text. Hovering it opens the larger image (or the video) next to
// the cursor; src/scripts/projects-media.ts reads these two data attributes.
const thumb = data.thumb ? asset(`projects/cards/${data.thumb}`) : undefined;
const square = data.thumbShape === 'square';
const peekSource = data.peekImage ? asset(`projects/cards/${data.peekImage}`) : thumb;
// The preview shows at up to 360px wide (720 on a sharp screen); it is made at 1000px, or the original's own width if
// that is smaller, and saved at a high quality.
const peek = peekSource ? (await getImage({ src: peekSource, width: Math.min(1000, peekSource.width), quality: 92 })).src : undefined;

// Each link becomes a pill (GitHub, Live site, Dev post or Video), picked from the link's label in the frontmatter.
// A label that matches none of these keeps its own wording.
const KINDS = [
  { test: /repo|github/i, label: 'GitHub', icon: 'github' },
  { test: /devpost|dev post/i, label: 'Dev post', icon: 'post' },
  { test: /video|tour|demo|teaser|youtube/i, label: 'Video', icon: 'video' },
  { test: /live|site/i, label: 'Live site', icon: 'live' },
];
const pills = data.links.map((link) => {
  const kind = KINDS.find((candidate) => candidate.test.test(link.label));
  return { href: link.href, label: kind?.label ?? link.label, icon: kind?.icon ?? 'live' };
});
---
<article class:list={['card', { 'card--thumb': thumb }]} id={id}>
  <div class="card__text">
    <h3 class="card__title display">{data.title}</h3>
    <p class="card__meta label">{[data.role, data.dates].filter(Boolean).join(' · ')}</p>
    <p class="card__summary">{data.summary}</p>
    <p class="card__status label">{data.status}</p>
    {pills.length > 0 && (
      <ul class="card__links">
        {pills.map((pill) => (
          <li>
            <a class="pill" href={pill.href} target="_blank" rel="noopener" aria-label={`${pill.label}: ${data.title}`}>
              {pill.icon === 'github' && (
                <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
              )}
              {pill.icon === 'live' && (
                <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11l6-6M6 5h5v5" /></svg>
              )}
              {pill.icon === 'video' && (
                <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M4.5 3v10l8-5z" /></svg>
              )}
              {pill.icon === 'post' && (
                <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2h5.5L13 5.5V14H4zM6.5 8h4M6.5 10.5h4" /></svg>
              )}
              {pill.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
  {thumb && (
    <div class:list={['card__frame', { 'card__frame--square': square }]}>
      <div
        class="card__thumb"
        data-peek={peek} data-peek-video={data.video ? `/projects/${data.video}` : undefined}>
        <Image
          src={thumb}
          alt={data.thumbAlt ?? `${data.title} screenshot`}
          widths={[320, 480, 640, 960, 1280]}
          quality={92}
          sizes="(min-width: 1100px) 11rem, 28rem"
          style={data.thumbPosition ? `object-position:${data.thumbPosition}` : undefined}
          loading="lazy"
        />
      </div>
      {data.badge && <Medal text={data.badge} detail={data.badgeDetail} />}
    </div>
  )}
</article>

<style>
  .card {
    display: grid;
    gap: 1rem clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    border-bottom: 1px solid var(--line);
  }

  /* The card whose preview is open (src/scripts/projects-media.ts) lifts a little. */
  .card {
    transition: transform 0.2s var(--ease);
  }

  .card.is-preview-active {
    transform: translateY(-2px);
  }

  .card__text {
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }

  .card__title {
    font-size: clamp(1.3rem, 1.05rem + 1vw, 2.25rem);
    overflow-wrap: anywhere;
  }

  .card__meta,
  .card__status {
    color: var(--muted);
  }

  .card__summary {
    font-family: Calibri, Carlito, 'Segoe UI', sans-serif;
    font-size: 1.125rem;
    max-width: 52ch;
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  /* An outlined pill in ink that fills on hover. A card has about two; a few have more, and they wrap. */
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem 0.5rem 0.8rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .pill:hover,
  .pill:focus-visible {
    background: var(--fg);
    color: var(--bg);
  }

  .pill svg {
    flex: none;
    width: 1em;
    height: 1em;
  }

  /* The frame does not clip, so the medal's hover card can hang over the thumbnail's edge. */
  .card__frame {
    --medal-size: 1.75rem;
    position: relative;
  }

  .card__thumb {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: var(--media-radius);
    background: var(--line);
    cursor: zoom-in;
  }

  .card__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Stacked, the thumbnail would stretch the card's whole width, so it is held to a sensible size. */
  .card__frame {
    max-width: 28rem;
  }

  /* A square widget is 1:1. Stacked, it is held to a modest size so it does not fill the card's width. */
  .card__frame--square .card__thumb {
    aspect-ratio: 1;
  }

  .card__frame--square {
    max-width: 14rem;
  }

  /* The cards sit two to a row from 800px, so the thumbnail only fits beside the text once each card is wide enough. */
  @media (min-width: 1100px) {
    .card--thumb {
      grid-template-columns: minmax(0, 1fr) clamp(8.5rem, 12vw, 11rem);
      align-items: start;
    }

    .card__frame,
    .card__frame--square {
      max-width: none;
    }
  }
</style>
