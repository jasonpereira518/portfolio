---
// The URL is passed as an inline custom property so the bundler does not try to resolve it at build time.
---
<div class="contours" aria-hidden="true" data-island="contours">
  <div class="contours__sway">
    <div class="contours__lines" style="--contour-url: url('/contours.svg')"></div>
  </div>
</div>

<style>
  /* The artwork tiles seamlessly. The lines layer is one tile larger than the section and slides by exactly
     one tile, so the drift never ends; a slower sway on top makes the path wander instead of running straight. */
  .contours {
    --tile-w: clamp(1200px, 120vw, 2000px);
    /* Whole pixels (a multiple of 8, so the height is whole too): a fractional tile makes the lines hop
       by a pixel each time the loop restarts. Browsers without round() keep the line above. */
    --tile-w: round(clamp(1200px, 120vw, 2000px), 8px);
    --tile-h: calc(var(--tile-w) * 0.625); /* the artwork is 1600 by 1000 */
    --sway: 90px;

    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .contours__sway {
    position: absolute;
    inset: calc(var(--sway) * -1.1); /* a little beyond the sway's reach, so no edge is ever left bare */
  }

  .contours__lines {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% + var(--tile-w));
    height: calc(100% + var(--tile-h));
    background: var(--line);
    -webkit-mask: var(--contour-url) 0 0 / var(--tile-w) var(--tile-h) repeat;
    mask: var(--contour-url) 0 0 / var(--tile-w) var(--tile-h) repeat;
  }

  /* With scripts, src/scripts/contours-live.ts draws lines that change shape on a canvas. Once its first frame
     is drawn (data-live), it fades in and the static, CSS-drifted artwork fades out and stops. */
  .contours :global(.contours__canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s var(--ease);
  }

  .contours[data-live] :global(.contours__canvas) {
    opacity: 1;
  }

  .contours[data-live] .contours__sway {
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 0.8s var(--ease),
      visibility 0s 0.8s;
  }

  .contours[data-live] .contours__sway,
  .contours[data-live] .contours__lines {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: no-preference) {
    .contours__lines {
      animation: contour-drift 90s linear infinite;
    }

    .contours__sway {
      animation: contour-sway 34s ease-in-out infinite;
    }
  }

  @keyframes contour-drift {
    from {
      translate: 0 0;
    }

    to {
      translate: calc(var(--tile-w) * -1) calc(var(--tile-h) * -1);
    }
  }

  /* A slow loop around the drift line, staying within --sway of it. */
  @keyframes contour-sway {
    0%,
    100% {
      translate: 0 0;
    }

    25% {
      translate: var(--sway) calc(var(--sway) * -0.6);
    }

    50% {
      translate: calc(var(--sway) * 0.2) var(--sway);
    }

    75% {
      translate: calc(var(--sway) * -0.9) calc(var(--sway) * 0.3);
    }
  }
</style>
